# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real domains/hosts.
# Quick start: ./setup.sh your-domain.com [upstream] creates `.env` for you.

# Public domain the redirector serves (Caddy will obtain a Let's Encrypt cert
# for it automatically). C2 traffic must use the www. hostname of this domain.
C2_DOMAIN=your-domain.com

# Upstream Phantom C2 listener the redirector forwards to.
# Default (when unset) is the Docker host gateway on port 8080 — i.e. the
# Phantom server running on the Docker host with the default HTTP listener.
# Uncomment to override:
# C2_UPSTREAM=10.0.0.5:8080
