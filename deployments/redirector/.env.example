# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real domains/hosts.

# Public domain the redirector serves (Caddy will obtain a Let's Encrypt cert
# for it automatically). C2 traffic must use this hostname.
C2_DOMAIN=your-domain.com

# Optional: the upstream Phantom C2 listener the redirector forwards to.
# Default is the Docker host gateway (172.17.0.1), port 8080 — i.e. the
# Phantom server running on the Docker host with the default HTTP listener.
# C2_UPSTREAM=172.17.0.1:8080
